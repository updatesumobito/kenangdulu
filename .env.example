APP_URL=http://127.0.0.1:3107
APP_MODE=commercial
DATABASE_URL=
# Local databases only. Remote migrations always require an explicit owner/operator command.
DATABASE_AUTO_MIGRATE=1
DATA_DIR=.data
AUTH_PROVIDER=local
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
STORAGE_DRIVER=local
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=komukuna-virtual-private
# During Supabase -> R2 migration only: legacy objects are read on R2 404.
# Keep Supabase bridge variables configured while this fallback is enabled.
STORAGE_FALLBACK_DRIVER=
PAYMENT_MODE=manual
PAYMENT_BANK_LABEL=
PAYMENT_BANK_ACCOUNT=
PAYMENT_BANK_OWNER=
ENABLE_DEMO=true
# Only for an isolated localhost production preview. Never use on public hosts.
LOCAL_PREVIEW=0
# Set 0 only when npm run worker is operated separately with external Postgres.
WORKER_EMBEDDED=1

VENDOR_CREDITS_ENABLED=false
NOTIFICATIONS_ENABLED=false
RETENTION_AUTO_PURGE_ENABLED=false
EMAIL_PROVIDER_URL=
EMAIL_PROVIDER_TOKEN=
EXPORT_PART_MAX_BYTES=268435456
STORAGE_MAX_OBJECT_BYTES=
STORAGE_COST_PER_GB_MONTH=
