APP_URL=http://127.0.0.1:3107
APP_MODE=commercial
DATABASE_URL=
# Set 0 for a deployed database migrated through MCP or an owner connection.
DATABASE_AUTO_MIGRATE=1
DATA_DIR=.data
AUTH_PROVIDER=local
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
STORAGE_DRIVER=local
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=komukuna-virtual-private
PAYMENT_MODE=manual
PAYMENT_BANK_LABEL=
PAYMENT_BANK_ACCOUNT=
PAYMENT_BANK_OWNER=
ENABLE_DEMO=true
# Only for an isolated localhost production preview. Never use on public hosts.
LOCAL_PREVIEW=0
# Set 0 only when npm run worker is operated separately with external Postgres.
WORKER_EMBEDDED=1
