{
    "name": "komukuna-virtual",
    "version": "2.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "next dev --webpack --hostname 0.0.0.0 --port 3107",
        "dev:prd": "node scripts/prd-preview.mjs",
        "build": "node scripts/runtime.mjs build",
        "start": "node scripts/runtime.mjs start",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src tests",
        "db:migrate": "tsx scripts/migrate.ts",
        "db:seed": "tsx scripts/seed.ts",
        "worker": "tsx scripts/worker.ts",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:report": "playwright show-report",
        "test:e2e:smoke": "playwright test --grep @smoke",
        "test:fixtures": "tsx scripts/fixtures.ts",
        "test:rls": "tsx tests/rls.ts",
        "db:catalog": "tsx scripts/catalog.ts",
        "admin:create": "tsx scripts/create-admin.ts",
        "admin:provision-supabase": "tsx scripts/provision-supabase-admin.ts",
        "personal:backup": "tsx scripts/personal-backup.ts"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "latest",
        "@aws-sdk/lib-storage": "^3.1156.0",
        "@aws-sdk/s3-request-presigner": "latest",
        "@electric-sql/pglite": "latest",
        "@ffprobe-installer/ffprobe": "^2.1.2",
        "@fontsource-variable/playfair-display": "^5.3.0",
        "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
        "@pdf-lib/fontkit": "1.1.1",
        "@supabase/supabase-js": "latest",
        "archiver": "latest",
        "fflate": "^0.8.3",
        "ffmpeg-static": "latest",
        "gifenc": "latest",
        "konva": "10.9.0",
        "lucide-react": "latest",
        "next": "^16.4.2",
        "pdf-lib": "latest",
        "postgres": "latest",
        "qrcode": "latest",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "react-konva": "19.3.2",
        "sharp": "latest",
        "zod": "latest"
    },
    "devDependencies": {
        "@playwright/test": "1.63.0",
        "@types/archiver": "latest",
        "@types/node": "latest",
        "@types/qrcode": "latest",
        "@types/react": "latest",
        "@types/react-dom": "latest",
        "eslint": "9.39.5",
        "eslint-config-next": "^16.4.2",
        "tsx": "latest",
        "typescript": "6.0.3"
    },
    "allowScripts": {
        "ffmpeg-static@5.3.0": true,
        "@ffprobe-installer/linux-x64@5.2.0": true,
        "esbuild@0.28.2": true,
        "unrs-resolver@1.12.2": true
    }
}
